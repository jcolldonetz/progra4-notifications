# Variables de entorno del server de notificaciones realtime (progra4-notifications).
# Copiar a las variables de entorno del sistema o definirlas antes de arrancar,
# por ejemplo en PowerShell:
#   $env:JWT_SECRET='...'; $env:REDIS_URL='127.0.0.1:6379'; php bin/notif-server.php
#
# WS_PORT=8081
# WS_HOST=127.0.0.1
# REDIS_URL=127.0.0.1:6379
# Debe coincidir con el JWT_SECRET de la API (progra4-api).
# JWT_SECRET=secreto-solo-para-desarrollo-cambiar
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173